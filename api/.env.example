# SourcebookLM API - local environment template.
# Copy to api/.env before running the API for real:  cp api/.env.example api/.env
# api/.env is gitignored - real keys never get committed (this file is safe to commit).

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sourcebooklm

# --- Chat provider: openai | deepseek ---
CHAT_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5-mini
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- Embeddings (OpenAI) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Web origin (CORS allowlist) + upload cap ---
WEB_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=20